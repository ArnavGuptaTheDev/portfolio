---
import Base from '../layouts/Base.astro';
import Dial from '../components/Dial.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import { person } from '../content';
---

<Base>
  <a class="skip-link" href="#main">Skip to content</a>
  <Hero />
  <main id="main">
    <Sections />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p class="phase-line js-only" aria-live="off"></p>
      <p>© {new Date().getFullYear()} {person.name}</p>
      <p><a href={person.source} target="_blank" rel="noopener">Site source<span class="sr-only"> on GitHub (opens in a new tab)</span></a></p>
    </div>
  </footer>
  <Dial />
  <div class="cursor" aria-hidden="true"><span class="cursor-ring"></span><span class="cursor-dot"></span></div>
  <script>
    import '../main';
  </script>
</Base>

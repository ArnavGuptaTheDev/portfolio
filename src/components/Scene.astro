---
import { cloudPuffs, curtain, grass, ground, pine, ridge, rng, roundTree, skyline } from '../scene/geometry';
import { VIEW_H, VIEW_W } from '../engine/vars';

const view = `0 0 ${VIEW_W} ${VIEW_H}`;
const ratio = 'xMidYMax slice';

// Peaks sit mid-frame; the valleys at either end are where the sun rises and sets.
const farthest = ridge(11, 595, 50, 34, 0.55, [[640, 120, 170], [910, 150, 190], [1150, 90, 140]]);
const far = ridge(23, 625, 50, 30, 0.7, [[600, 120, 150], [980, 105, 140], [1210, 60, 110]]);
const mid = ridge(37, 690, 60, 90, 0.25, [[420, 40, 260], [1350, 50, 260]]);
const city = skyline(5, 560, 1060, 770);
const buildingsPath = city.buildings
  .map((b) => `M${b.x},${b.y}h${b.w}v${b.h}h-${b.w}Z` + (b.antenna ? `M${b.x + b.w / 2 - 1},${b.y}h2v-${b.antenna}h-2Z` : ''))
  .join('');
const GROUND = 790;
const groundPath = ground(GROUND);
const grassPath = grass(41, GROUND);
const trees =
  pine(70, 800, 210) + pine(150, 805, 160) + pine(235, 800, 120) + roundTree(330, 800, 120) +
  pine(1355, 800, 130) + roundTree(1440, 805, 150) + pine(1530, 800, 200) + pine(1610, 805, 150) +
  pine(575, 795, 70) + roundTree(1030, 795, 74);

const rand = rng(97);
const clouds = [
  { x: 120, y: 140, w: 280, s: 1 },
  { x: 560, y: 80, w: 360, s: 0.7 },
  { x: 980, y: 200, w: 240, s: 1.2 },
  { x: 1320, y: 110, w: 320, s: 0.85 },
  { x: 1700, y: 250, w: 220, s: 1.1 },
  { x: 380, y: 290, w: 180, s: 1.3 },
].map((c, i) => ({ ...c, puffs: cloudPuffs(i + 3, c.w) }));
const dew = Array.from({ length: 18 }, (_, i) => ({ x: 420 + i * 44 + rand() * 30, y: GROUND - 6 - rand() * 18 }));
const fireflies = Array.from({ length: 28 }, (_, i) => i);
const birds = Array.from({ length: 6 }, (_, i) => ({ x: (i % 3) * 22 + Math.floor(i / 3) * 12, y: Math.abs(i - 2.5) * 9 }));
const aurora = [curtain(3, 80, 900, 120, 340), curtain(8, 600, 1500, 90, 300), curtain(13, 1100, 1700, 150, 330)];
const sparkle = 'M0,-5L1.1,-1.1L5,0L1.1,1.1L0,5L-1.1,1.1L-5,0L-1.1,-1.1Z';
---

<div class="scene" aria-hidden="true">
  <svg class="scene-svg scene-sky" viewBox={view} preserveAspectRatio={ratio} focusable="false">
    <defs>
      <linearGradient id="g-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color:var(--sky0)"></stop>
        <stop offset="0.48" style="stop-color:var(--sky1)"></stop>
        <stop offset="0.78" style="stop-color:var(--sky2)"></stop>
        <stop offset="1" style="stop-color:var(--sky2)"></stop>
      </linearGradient>
      <radialGradient id="g-horizon">
        <stop offset="0" style="stop-color:var(--sky3);stop-opacity:0.95"></stop>
        <stop offset="0.45" style="stop-color:var(--sky3);stop-opacity:0.35"></stop>
        <stop offset="1" style="stop-color:var(--sky3);stop-opacity:0"></stop>
      </radialGradient>
      <radialGradient id="g-milky">
        <stop offset="0" stop-color="#dfe4ff" stop-opacity="0.16"></stop>
        <stop offset="0.5" stop-color="#b7c2ff" stop-opacity="0.07"></stop>
        <stop offset="1" stop-color="#b7c2ff" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="g-fade-x" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.3" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="0.7" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <mask id="m-fade-x" maskContentUnits="objectBoundingBox">
        <rect width="1" height="1" fill="url(#g-fade-x)"></rect>
      </mask>
      <linearGradient id="g-aurora" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7a5cff" stop-opacity="0"></stop>
        <stop offset="0.35" stop-color="#8f6bff" stop-opacity="0.35"></stop>
        <stop offset="0.7" stop-color="#4ef0b0" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#4ef0b0" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <rect width={VIEW_W} height={VIEW_H} fill="url(#g-sky)"></rect>
    <g data-depth="0.06">
      <g class="milky">
        <g transform="rotate(-24 820 300)">
          <ellipse cx="820" cy="300" rx="1000" ry="150" fill="url(#g-milky)" opacity="0.7"></ellipse>
          <ellipse cx="560" cy="292" rx="420" ry="95" fill="url(#g-milky)"></ellipse>
          <ellipse cx="980" cy="312" rx="480" ry="110" fill="url(#g-milky)"></ellipse>
          <ellipse cx="1320" cy="296" rx="300" ry="80" fill="url(#g-milky)" opacity="0.8"></ellipse>
        </g>
      </g>
      <g class="aurora">
        {aurora.map((d) => <path class="aurora-curtain" d={d} fill="url(#g-aurora)" mask="url(#m-fade-x)"></path>)}
      </g>
    </g>
    <g data-depth="0.1">
      <ellipse class="horizon-glow" cx="0" cy="0" rx="760" ry="260" fill="url(#g-horizon)"></ellipse>
    </g>
  </svg>

  <canvas class="scene-stars"></canvas>

  <svg class="scene-svg scene-land" viewBox={view} preserveAspectRatio={ratio} focusable="false">
    <defs>
      <radialGradient id="g-bloom">
        <stop offset="0" style="stop-color:var(--sun);stop-opacity:0.75"></stop>
        <stop offset="0.25" style="stop-color:var(--sun);stop-opacity:0.3"></stop>
        <stop offset="1" style="stop-color:var(--sun);stop-opacity:0"></stop>
      </radialGradient>
      <radialGradient id="g-halo">
        <stop offset="0.15" stop-color="#e8eeff" stop-opacity="0.35"></stop>
        <stop offset="0.5" stop-color="#c6d2ff" stop-opacity="0.08"></stop>
        <stop offset="1" stop-color="#c6d2ff" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="g-ray" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color:var(--sun);stop-opacity:0.55"></stop>
        <stop offset="1" style="stop-color:var(--sun);stop-opacity:0"></stop>
      </linearGradient>
      <radialGradient id="g-puff">
        <stop offset="0" style="stop-color:var(--cloud);stop-opacity:0.95"></stop>
        <stop offset="0.7" style="stop-color:var(--cloud);stop-opacity:0.85"></stop>
        <stop offset="1" style="stop-color:var(--cloud);stop-opacity:0"></stop>
      </radialGradient>
      <radialGradient id="g-puff-shade">
        <stop offset="0" style="stop-color:color-mix(in oklab, var(--cloud) 70%, var(--sky0));stop-opacity:0.7"></stop>
        <stop offset="1" style="stop-color:color-mix(in oklab, var(--cloud) 70%, var(--sky0));stop-opacity:0"></stop>
      </radialGradient>
      <radialGradient id="g-mist">
        <stop offset="0" style="stop-color:var(--fog);stop-opacity:0.85"></stop>
        <stop offset="1" style="stop-color:var(--fog);stop-opacity:0"></stop>
      </radialGradient>
      <linearGradient id="g-haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color:var(--fog);stop-opacity:0"></stop>
        <stop offset="1" style="stop-color:var(--fog);stop-opacity:0.9"></stop>
      </linearGradient>
      <radialGradient id="g-firefly">
        <stop offset="0" stop-color="#fff6b0" stop-opacity="1"></stop>
        <stop offset="0.2" stop-color="#f4e66a" stop-opacity="0.75"></stop>
        <stop offset="1" stop-color="#d9e65a" stop-opacity="0"></stop>
      </radialGradient>
      <filter id="f-shimmer" x="0" y="-0.05" width="1" height="1.1">
        <feTurbulence class="shimmer-noise" type="fractalNoise" baseFrequency="0.004 0.08" numOctaves="1" seed="2"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="4" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>

    <g data-depth="0.1">
      <g class="sun" data-egg>
        <circle class="sun-bloom" r="240" fill="url(#g-bloom)"></circle>
        <circle class="sun-core" r="34" style="fill:var(--sun)"></circle>
      </g>
      <g class="rays">
        {[-28, -14, -3, 9, 22, 34].map((a, i) => (
          <path d={`M0,0L1500,${-30 - i * 9}L1500,${30 + i * 9}Z`} transform={`rotate(${a})`} fill="url(#g-ray)" opacity={0.5 + (i % 3) * 0.2}></path>
        ))}
      </g>
      <g class="moon" data-egg>
        <circle r="150" fill="url(#g-halo)"></circle>
        <circle class="moon-dark" r="24"></circle>
        <path class="moon-lit" d=""></path>
      </g>
    </g>

    <g data-depth="0.16" class="clouds">
      {clouds.map((c) => (
        <g class="cloud" data-x={c.x} data-w={c.w} data-s={c.s} transform={`translate(${c.x} ${c.y})`}>
          {c.puffs.map(([cx, cy, r]) => <circle cx={cx} cy={cy + r * 0.12} r={r} fill="url(#g-puff-shade)"></circle>)}
          {c.puffs.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} fill="url(#g-puff)"></circle>)}
        </g>
      ))}
    </g>

    <g data-depth="0.22">
      <path class="ridge-farthest" d={farthest}></path>
      <rect x="-200" y="430" width="2000" height="290" fill="url(#g-haze)" class="haze haze-far"></rect>
      <g class="shimmer-target">
        <path class="ridge-far" d={far}></path>
      </g>
      <rect x="-200" y="520" width="2000" height="220" fill="url(#g-haze)" class="haze haze-mid"></rect>
    </g>

    <g data-depth="0.3" class="birds">
      <g class="flock">
        {birds.map((b) => (
          <path class="bird" transform={`translate(${b.x} ${b.y})`} d="M-7,0Q-3.5,-4 0,0Q3.5,-4 7,0"></path>
        ))}
      </g>
    </g>

    <g data-depth="0.36" class="mists mists-back">
      <ellipse class="mist" data-s="0.6" cx="300" cy="650" rx="520" ry="46" fill="url(#g-mist)"></ellipse>
      <ellipse class="mist" data-s="0.4" cx="1200" cy="640" rx="620" ry="52" fill="url(#g-mist)"></ellipse>
    </g>

    <g data-depth="0.45">
      <path class="ridge-mid" d={mid}></path>
    </g>

    <g data-depth="0.55" class="city">
      <path class="buildings" d={buildingsPath}></path>
      <g class="windows">
        {city.windows.map((w) => <rect class="win" x={w.x} y={w.y} width="3" height="4" data-r={w.rank.toFixed(3)}></rect>)}
      </g>
    </g>

    <g data-depth="0.62" class="mists mists-front">
      <ellipse class="mist" data-s="0.9" cx="800" cy="745" rx="700" ry="40" fill="url(#g-mist)"></ellipse>
      <ellipse class="mist" data-s="0.7" cx="80" cy="760" rx="460" ry="36" fill="url(#g-mist)"></ellipse>
    </g>

    <g data-depth="0.9" class="near">
      <path d={groundPath}></path>
      <path d={grassPath}></path>
      <path d={trees}></path>
      <g class="dew">
        {dew.map((p) => <path class="sparkle" transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} d={sparkle}></path>)}
      </g>
    </g>

    <g data-depth="1" class="fireflies">
      {fireflies.map(() => (
        <g class="firefly"><circle r="9" fill="url(#g-firefly)"></circle></g>
      ))}
    </g>
  </svg>
  <div class="scene-fade"></div>
</div>

---
import { hero, nav, person } from '../content';
import Scene from './Scene.astro';
const [first, ...rest] = person.name.split(' ');
---

<header class="hero" id="top">
  <Scene />
  <div class="topbar container">
    <a class="brand" href="#top" aria-label={`${first[0]}${rest.join(" ")[0]}, ${person.name}, back to top`} data-magnetic>{first[0]}<span>{rest.join(' ')[0]}</span></a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((l) => <li><a href={l.href} data-magnetic>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="hero-inner container">
    <div class="hero-copy">
      <p class="eyebrow">{person.role}</p>
      <h1 class="hero-name" data-scramble>{person.name}</h1>
      <p class="hero-tagline">{person.tagline}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={hero.primary.href} data-magnetic>
          {hero.primary.label}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3 8.5 8 13.5l5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href} download={person.resumeFilename} target="_blank" rel="noopener" data-magnetic>
          {hero.secondary.label}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
  </div>
</header>

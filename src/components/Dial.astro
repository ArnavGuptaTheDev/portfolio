<div class="dial js-only" data-dial>
  <div class="dial-readout" aria-hidden="true">
    <span class="dial-phase">Daytime</span>
    <span class="dial-time">13:00</span>
  </div>
  <div
    class="dial-face"
    role="slider"
    tabindex="0"
    aria-label="Time of day for the scene"
    aria-valuemin="0"
    aria-valuemax="1439"
    aria-valuenow="780"
    aria-valuetext="13:00, daytime"
    aria-describedby="dial-help"
  >
    <span class="dial-ring"></span>
    <span class="dial-knob"></span>
  </div>
  <span id="dial-help" class="sr-only">Drag, or use the arrow keys, to move through the day. Home returns to the current time.</span>
  <button class="dial-now" type="button" hidden>Back to now</button>
</div>
